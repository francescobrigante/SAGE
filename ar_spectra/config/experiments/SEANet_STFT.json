{
  "seed": 94,
  "device": "cuda",
  "train_dataset": {
    "class": "ar_spectra.dataset.OnTheFlySTFTDataset",
    "kwargs": {
      "audio_dir": "/home/cerovaz/repos/data/jamendo_full/train",
      "target_frames": 128,
      "sample_rate": 44100,
      "n_fft": 2048,
      "hop_length": 512,
      "win_length": 2048,
      "center": true,
      "normalized": false,
      "extensions": [".mp3"],
      "stereo": false,
      "cac": true,
      "skip_broken_files": true,
      "skip_criteria": ["sample_rate"]  
    }
  },
  "train_dataloader": {
    "batch_size": 8,
    "num_workers": 8,
    "prefetch_factor": 8,
    "pin_memory": "false",
    "persistent_workers": false,
    "shuffle": true,
    "pin_memory_device": "cuda"
  },
  "eval_dataset": {
    "class": "ar_spectra.dataset.OnTheFlySTFTDataset",
    "kwargs": {
      "audio_dir": "/home/cerovaz/repos/data/jamendo_full/eval",
      "target_frames": 128,
      "sample_rate": 44100,
      "n_fft": 2048,
      "hop_length": 512,
      "win_length": 2048,
      "center": true,
      "normalized": false,
      "extensions": [".mp3"],
      "stereo": false,
      "cac": true,
      "skip_broken_files": true,
      "skip_criteria": ["sample_rate"]  

    }
  },
  "eval_dataloader": {
    "batch_size": 8,
    "num_workers": 8,
    "prefetch_factor": 8,
    "pin_memory": "false",
    "persistent_workers": false,
    "shuffle": false,
    "pin_memory_device": "cuda"
  },
    "model": {
    "autoencoder": { "return_latent": false},
    "encoder": {
      "class": "ar_spectra.models.autoencoders.SeaNET_AE.SEANetEncoder2d",
      "kwargs": {
        "input_size": "auto",
        "dimension": 128,
        "n_filters": 64,
        "n_residual_layers": 1,
        "ratios": [[16,1],[4,4],[4,1]],
        "activation": "ELU",
        "norm": "time_group_norm",
        "norm_params": { "num_groups": 1 },
        "causal": false,
        "latent_fbins": 4,
        "dilation_base": 2
      }
    },
    "decoder": {
      "class": "ar_spectra.models.autoencoders.SeaNET_AE.SEANetDecoder2d",
      "kwargs": {
        "channels": "auto",
        "input_size": 128,
        "n_filters": 64,
        "n_residual_layers": 1,
        "ratios": [[16,1],[4,4],[4,1]],
        "activation": "ELU",
        "norm": "time_group_norm",
        "norm_params": { "num_groups": 1 },
        "causal": false,
        "latent_fbins": 4,
        "dilation_base": 2
      }
    },
    "bottleneck": {
      "class": "ar_spectra.models.bottlenecks.VAEBottleneck",
      "skip_bottleneck": true
    }
  },
  "optimizer": {
    "type": "AdamW",
    "config": { "lr": 0.0003, "weight_decay": 1e-3 }
  },
  "scheduler": {
    "type": "InverseLR",
    "config": {
      "inv_gamma": 30000,
      "power": 0.5,
      "warmup": 0.995
    }
  },
  "trainer": {
    "epochs": 100,
    "amp": false,
    "log_interval": 1,
    "ckpt_dir": "checkpoints/seanet_stft",
    "profile": false,
    "check_val_every_n_epoch": 1,
    "log_model_structure": true
  },
  "wandb": {
    "project": "ICML_2026",
    "name": "SEANet_STFT",
    "use_wandb": true
  },
  "eval_loss_config": {
    "sisdr": {
      "zero_mean": true,
      "reduction": "mean"
    }
  },
  "demo": {
    "every_n_epochs": 1,
    "max_demos": 7,
    "target_seconds": 1,
    "istft_params": {
      "sample_rate": 44100,
      "n_fft": 2048,
      "hop_length": 512,
      "win_length": 2048,
      "target_frames": 128,
      "center": true,
      "normalized": false
    },
    "save_basename": "recon_val"
  },
  "loss_config": {
    "spectral": {
      "mse": {
        "config": {
          "normalize": "none",
          "p": 2.0,
          "reduction": "mean",
          "bin_weighted": false
        }
      },
      "weights": { "mrstft": 1.0 }
    }
  }
}
